{
  "name": "joule",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Joule — Battery, Power & Charging Analyzer for macOS. Track battery discharge over time and explore it in 3D.",
  "bin": {
    "joule": "bin/cli.js"
  },
  "scripts": {
    "start": "node bin/cli.js serve",
    "serve": "node server.js",
    "sample": "node bin/sampler.js",
    "demo": "node scripts/gen-demo.js",
    "demo2": "node scripts/gen-demo2.js",
    "build:binary": "bash scripts/build-binary.sh",
    "build:app": "bash scripts/build-app.sh",
    "test": "node --test tests/*.test.js",
    "report": "node -e \"import('./lib/report.js').then(m=>console.log(JSON.stringify(m.buildReport(m.readSamples('data/samples.jsonl')),null,2)))\""
  },
  "engines": {
    "node": ">=18"
  }
}
