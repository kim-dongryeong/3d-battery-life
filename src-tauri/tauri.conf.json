{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Joule",
  "version": "1.2.3",
  "identifier": "kr.kdr.joule",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Joule — 분석 리포트",
        "width": 1240,
        "height": 860,
        "visible": false,
        "url": "http://localhost:4317"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFFNTAzNDNDRjBBQkVEMDUKUldRRjdhdndQRFJRcnZhc0s5M1hrRXBQRXpZOTVwUSswTVFlZGtOUU02ZUF1NXBIa21mQnZINysK",
      "endpoints": [
        "https://github.com/kim-dongryeong/joule-battery-power-charging-analyzer/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns"
    ],
    "externalBin": [
      "binaries/joule",
      "binaries/joule-smcd"
    ],
    "resources": {
      "../web": "web"
    },
    "macOS": {
      "files": {
        "Library/LaunchAgents/kr.kdr.joule.sampler.plist": "../launchd/bundle/kr.kdr.joule.sampler.plist",
        "Library/LaunchAgents/kr.kdr.joule.smcd.plist": "../launchd/bundle/kr.kdr.joule.smcd.plist"
      }
    }
  }
}
