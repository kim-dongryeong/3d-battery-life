{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "3D Battery Life",
  "version": "0.1.0",
  "identifier": "com.kdr.battery-life",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "3D 분석 리포트",
        "width": 1240,
        "height": 860,
        "visible": false,
        "url": "http://localhost:4317"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns"],
    "externalBin": ["binaries/battery-life", "binaries/battery-life-smcd"],
    "resources": {
      "../web": "web"
    }
  }
}
