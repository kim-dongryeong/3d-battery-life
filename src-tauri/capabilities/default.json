{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Allow the main window to run the battery-life sidecar.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [{ "name": "binaries/battery-life", "sidecar": true, "args": true }]
    }
  ]
}
