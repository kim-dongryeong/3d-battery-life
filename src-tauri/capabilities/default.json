{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Allow the main window to run the joule sidecar.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [{ "name": "binaries/joule", "sidecar": true, "args": ["serve"] }]
    }
  ]
}
